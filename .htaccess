ErrorDocument 401 /errors/401.php
ErrorDocument 403 /errors/403.php
ErrorDocument 404 /errors/404.php
ErrorDocument 413 /errors/413.php
ErrorDocument 500 /errors/500.php
ErrorDocument 503 /errors/503.php

Options -Indexes
# Aktiviert das URL-Rewriting
RewriteEngine On
RewriteBase /

# Wenn die Datei oder der Ordner existiert, nichts ändern
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Leitet "seite" auf "seite.php" weiter (funktioniert auch in Unterordnern)
RewriteRule ^([a-zA-Z0-9/_-]+)$ $1.php [L]

# Optional: Leitet "seite.php" automatisch zu "seite" weiter (schöne URL)
RewriteCond %{THE_REQUEST} \s/([^.]+)\.php [NC]
RewriteRule ^ /%1 [R=301,L]
